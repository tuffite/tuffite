[Exposed=Window, RuntimeEnabled=TuffiteExplorer] interface ExplorerTransfer : EventTarget {
    readonly attribute DOMString token;
    readonly attribute DOMString state;
    [CallWith=ScriptState] Promise<undefined> close();
    attribute EventHandler onstatechange;
};

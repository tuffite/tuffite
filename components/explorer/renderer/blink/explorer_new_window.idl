[Exposed=Window, RuntimeEnabled=TuffiteExplorer] interface ExplorerNewWindow {
  readonly attribute DOMString url;
  readonly attribute DOMString disposition;
  readonly attribute DOMString from;
  readonly attribute boolean userGesture;
  readonly attribute AbortSignal signal;
  [CallWith=ScriptState] Promise<boolean> attach(HTMLExplorerElement target);
  [CallWith=ScriptState] Promise<boolean> discard();
};

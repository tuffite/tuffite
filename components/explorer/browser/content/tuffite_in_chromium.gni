import("//tuffite/tuffite_in_chromium.gni")

# The header itself is included unconditionally so Chromium code can compile
# both integration states. Feature implementation dependencies stay conditional.
tuffite_content_buildflag_deps = [ "//tuffite:buildflags" ]

tuffite_content_explorer_isolation_sources = [
  "//tuffite/components/explorer/browser/content/explorer_frame_ancestry.cc",
  "//tuffite/components/explorer/browser/content/explorer_frame_ancestry.h",
  "//tuffite/components/explorer/browser/content/explorer_isolation.cc",
  "//tuffite/components/explorer/browser/content/explorer_isolation.h",
]

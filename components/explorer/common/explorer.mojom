module tuffite.mojom;

import "third_party/blink/public/mojom/tokens/tokens.mojom";
import "third_party/blink/public/mojom/frame/frame_policy.mojom";
import "third_party/blink/public/mojom/messaging/transferable_message.mojom";

struct ExplorerCreateParams {
  blink.mojom.LocalFrameToken frame_to_replace;
  string initial_url;
  string partition;
  string navigation;
  string dialogs;
  bool isolated = false;
  bool context_menu_enabled;
  blink.mojom.FramePolicy frame_policy;
};

interface ExplorerClient {
  // Event payloads are JSON objects so Blink can expose their fields as
  // CustomEvent.detail without growing an event-specific WebIDL type graph.
  DidDownload(string detail_json);
  DidStartLoading(string state_json);
  DidStopLoading(string state_json);
  DidFailLoad(int32 error_code, string error_description,
              string state_json);
  DidCommitNavigation(string state_json);
  DidChangePageState(string event_type, string state_json);
  DidFindResult(string detail_json);
  DidRequestOpen(uint64 request_id, string event_type, string request_json);
  DidRequestDialog(uint64 request_id, string type, string message,
                   string default_value, bool is_reload, string from);
  DidFinishRequest(string kind, string key, bool canceled);
};

// A document-scoped bridge used to replace an about:blank child frame with a
// normal WebContents. This intentionally does not use GuestView.
interface ExplorerTransferClient {
  StateChanged(string state);
};

interface ExplorerTransferControl {
  // Commit delivery before resolving detach(). Undelivered detach replies must
  // not leave a resource that the application has no credential to release.
  Accept();
  Close() => (string error);
  BeginTransfer();
  RebindClient(pending_remote<ExplorerTransferClient> client);
};

interface ExplorerHost {
  Detach(pending_remote<ExplorerTransferClient> client)
      => (string token, pending_remote<ExplorerTransferControl>? control,
          string error);
  Attach(string token, ExplorerCreateParams params,
         pending_remote<ExplorerClient> client) => (string error);
  Create(ExplorerCreateParams params,
         pending_remote<ExplorerClient> client) => (bool accepted);
  Navigate(string url) => (bool accepted);
  Go(int32 offset) => (bool accepted);
  Reload(bool bypass_cache) => (bool accepted);
  Stop() => (bool accepted);
  GetNavigationState() => (string state_json);
  FindInPage(string text, bool forward, bool match_case, bool find_next)
      => (int32 request_id);
  StopFindInPage(string action) => (bool accepted);
  SetZoomFactor(double factor) => (bool accepted);
  GetZoomFactor() => (double factor);
  SetAudioMuted(bool muted) => (bool accepted);
  ExecuteJavaScript(string source, bool main_world,
                    string expected_document_id)
      => (bool success, string json_result, string error);
  RespondToDialog(uint64 request_id, bool accept, string prompt_text)
      => (bool accepted);
  DiscardWindow(string token) => (bool accepted);
  CompleteOpen(uint64 request_id, bool propagate);
  CompleteDialog(uint64 request_id, bool propagate);
  SetContextMenuEnabled(bool enabled);
  SetFramePolicy(blink.mojom.FramePolicy frame_policy);
  Download(string url) => (bool accepted);
  GetDownloads() => (string detail_json);
  CancelDownload(uint32 id) => (bool accepted);
  ReadDownload(uint32 id) => (string base64_data, string error);
  CapturePreview() => (string data_url);
};

// Main-document request controllers, native ancestry updates, and WindowInfo
// message delivery. WindowProxy messages use Chromium's normal frame IPC.
interface ExplorerSurfaceClient {
  DidChangeAncestors(array<blink.mojom.FrameToken> ancestors, array<blink.mojom.FramePolicy?> frame_policies, array<bool> isolation_boundaries) => (bool ready);
  DidFinishRequest(string kind, string key, bool canceled);
  DidReceiveOpen(string event_type, string request_json);
  DidReceiveDialog(uint64 request_id, string type, string message,
                   string default_value, bool is_reload, string from);
};

interface ExplorerSurfaceHost {
  [Sync] GetFrameAncestors() => (array<blink.mojom.FrameToken> ancestors, array<blink.mojom.FramePolicy?> frame_policies, array<bool> isolation_boundaries);
  PostWindowMessage(int64 window_id, blink.mojom.TransferableMessage message, string target_origin);
  BindClient(pending_remote<ExplorerSurfaceClient> client);
  DiscardWindow(string token) => (bool accepted);
  CompleteDialog(uint64 request_id, bool propagate);
  CompleteOpen(string token, bool propagate);
  RespondToDialog(uint64 request_id, bool accept, string prompt_text)
      => (bool accepted);
};

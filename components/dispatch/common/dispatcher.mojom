module tuffite.mojom;

interface DispatchClient {
  DispatchChannelEvent(string channel, array<uint8> payload);
};

// Document-scoped event subscription. Commands bind their own Mojo interfaces.
interface EventSource {
  BindClient(pending_remote<DispatchClient> client);
};

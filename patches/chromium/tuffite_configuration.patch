--- a/content/browser/child_process_launcher_helper.cc
+++ b/content/browser/child_process_launcher_helper.cc
@@ -4,6 +4,13 @@
 
 #include "content/browser/child_process_launcher_helper.h"
 
+// TUFFITE_BEGIN
+#include "tuffite/buildflags.h"
+#if BUILDFLAG(TUFFITE_IN_CHROMIUM)
+#include "tuffite/components/process_config/process_config.h"
+#endif
+// TUFFITE_END
+
 #include <optional>
 
 #include "base/base_switches.h"
@@ -332,6 +339,26 @@ void ChildProcessLauncherHelper::LaunchOnLauncherThread() {
       *command_line(), options_ptr, files_to_register.get());
   PassFieldTrialSharedMemoryHandle(*command_line(), options_ptr,
                                    files_to_register.get());
+#if BUILDFLAG(TUFFITE_IN_CHROMIUM)
+  static_assert(tuffite::kBootstrapDescriptorKey == kContentIPCDescriptorMax);
+  bool tuffite_needs_bootstrap = true;
+#if BUILDFLAG(USE_ZYGOTE)
+  // Forked children inherit the already parsed immutable zygote snapshot.
+  tuffite_needs_bootstrap = !GetZygoteForLaunch();
+#endif
+  if (tuffite_needs_bootstrap &&
+      tuffite::ProcessConfigurationRegion().IsValid()) {
+    base::shared_memory::SharedMemorySwitch tuffite_bootstrap(
+        tuffite::kBootstrapHandleSwitch, tuffite::kBootstrapRendezvousKey,
+        tuffite::kBootstrapDescriptorKey);
+    tuffite_bootstrap.AddToLaunchParameters(
+        tuffite::ProcessConfigurationRegion(), command_line(), options_ptr);
+    TransferSharedMemorySwitchDescriptor(tuffite_bootstrap,
+                                         files_to_register.get());
+  }
+
+#endif
+
   PassStartupTracingConfigSharedMemoryHandle(
       tracing_config_memory_region_ ? &tracing_config_memory_region_->data
                                     : nullptr,

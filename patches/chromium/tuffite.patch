+#if BUILDFLAG(TUFFITE_IN_CHROMIUM)
+std::unique_ptr<WebContents>
+WebContentsImpl::WebContentsTreeNode::ReleaseExplorerOwnership(
+    WebContents* inner_web_contents) {
+  CHECK_EQ(inner_web_contents->GetOuterWebContents(), current_web_contents_);
+  auto found = std::ranges::find_if(
+      owned_inner_web_contents_, [inner_web_contents](const auto& contents) {
+        return contents.get() == inner_web_contents;
+      });
+  CHECK(found != owned_inner_web_contents_.end());
+  auto owned = std::move(*found);
+  owned_inner_web_contents_.erase(found);
+  unowned_inner_web_contents_.push_back(inner_web_contents);
+  return owned;

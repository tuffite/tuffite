# Native bindings use Chromium's parser, resolved IR and C++ template engine.
import("//mojo/public/tools/bindings/mojom.gni")
import("//tuffite/tuffite_in_chromium.gni")

template("shell_api_protocol") {
  assert(tuffite_in_chromium)
  _consumer = target_name
  _definitions = invoker.definitions
  _contract_dir = get_path_info(_definitions[0], "dir")
  _output_dir = "$root_gen_dir/" + string_replace(_contract_dir, "//", "")
  _parser = "${target_name}_parser"
  _generator = "${target_name}_generator"
  _modules = []
  _headers = []
  _sources = []
  _wire_templates = []
  _wire_sources = []
  _bindings = []
  _generated = []
  foreach(_source, _definitions) {
    assert(get_path_info(_source, "dir") == _contract_dir)
    _path = "$root_gen_dir/" + string_replace(_source, "//", "")
    _modules += [ "${_path}-module" ]
    _headers += [ "${_path}-h" ]
    _sources += [ "${_path}-cc" ]
    _wire_templates += [ "${_path}-wire.mojom.inc" ]
    _wire_sources += [ "${_path}-wire.mojom" ]
    _bindings += [
      "${_path}.h",
      "${_path}.cc",
    ]
    _generated += [
      "${_path}-h",
      "${_path}-cc",
      "${_path}-wire.mojom.inc",
      "${_path}-macros.inc",
    ]
  }
  _filelist = "$target_gen_dir/${_consumer}.inputs"
  _metadata = "$target_gen_dir/${_consumer}.imports.json"
  write_file(_filelist, rebase_path(_definitions, root_build_dir))
  _import_metadata = {
    sources = rebase_path(_definitions, get_path_info(_metadata, "dir"))
    deps = []
  }
  write_file(_metadata, _import_metadata, "json")
  action(_parser) {
    script = mojom_parser_script
    sources = _definitions
    inputs = mojom_parser_sources + ply_sources + [
               _filelist,
               _metadata,
             ]
    outputs = _modules
    args = [
      "--input-root",
      rebase_path("//", root_build_dir),
      "--input-root",
      rebase_path(root_gen_dir, root_build_dir),
      "--output-root",
      rebase_path(root_gen_dir, root_build_dir),
      "--mojom-file-list=" + rebase_path(_filelist, root_build_dir),
      "--check-imports",
      rebase_path(_metadata, root_build_dir),
    ]
  }
  action(_generator) {
    script = mojom_generator_script
    sources = _definitions
    _templates = [
      "//tuffite/build/mojom_templates/macros.inc.tmpl",
      "//tuffite/build/mojom_templates/wire.mojom.inc.tmpl",
      "//tuffite/build/mojom_templates/h.tmpl",
      "//tuffite/build/mojom_templates/cc.tmpl",
    ]
    inputs = mojom_generator_sources + jinja2_sources + _modules + _templates +
             [ _filelist ]
    outputs = _generated
    deps = [ ":$_parser" ]

    # Extra-only generation avoids producing unused Mojo endpoint bindings at
    # the same .mojom.{h,cc} paths owned by the Dispatch interface projection.
    args = [
      "--use_bundled_pylibs",
      "-o",
      rebase_path(root_gen_dir, root_build_dir),
      "generate",
      "-d",
      rebase_path("//", root_build_dir),
      "-g",
      "c++",
      "--bytecode_path",
      rebase_path(root_gen_dir, root_build_dir),
      "--generate_extra_cpp_only",
      "--filelist=" + rebase_path(_filelist, root_build_dir),
    ]
    foreach(_template, _templates) {
      args += [
        "--extra_cpp_template_paths",
        rebase_path(_template, root_build_dir),
      ]
    }
  }
  copy("${_consumer}_headers") {
    sources = _headers
    outputs = [ "$_output_dir/{{source_name_part}}.mojom.h" ]
    deps = [ ":$_generator" ]
  }
  copy("${_consumer}_sources") {
    sources = _sources
    outputs = [ "$_output_dir/{{source_name_part}}.mojom.cc" ]
    deps = [ ":$_generator" ]
  }

  # A final .inc also avoids Chromium's rstrip(".tmpl") truncating '.mojom'.
  copy("${_consumer}_wire_sources") {
    sources = _wire_templates
    outputs = [ "$_output_dir/{{source_name_part}}" ]
    deps = [ ":$_generator" ]
  }
  mojom("${_consumer}_wire") {
    sources = _wire_sources
    parser_deps = [ ":${_consumer}_wire_sources" ]
    cpp_only = true
    disable_variants = true
  }
  source_set(_consumer) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])
    sources = _bindings
    public_deps = [
      ":${_consumer}_wire",
      "//tuffite/components/dispatch/browser",
      "//tuffite/components/dispatch/common:implementation",
    ]
    deps = [
      ":${_consumer}_headers",
      ":${_consumer}_sources",
    ]
  }
}

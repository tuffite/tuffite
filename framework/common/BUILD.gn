import("//tuffite/tuffite_in_chromium.gni")

assert(tuffite_in_chromium)

import("//testing/test.gni")

action("scope_registry") {
  script = "//tuffite/build/scope_registry.py"
  inputs = [ "//tuffite/framework/shell_api/scope_registry.json" ]
  outputs = [ "$target_gen_dir/scope_registry.inc" ]
  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]
}

source_set("common") {
  sources = [
    "app_manifest.cc",
    "app_manifest.h",
    "constants.h",
    "content_client.cc",
    "content_client.h",
  ]
  deps = [
    ":scope_registry",
    "//base",
    "//content/public/common",
    "//net",
    "//tuffite:buildflags",
    "//tuffite/framework/common:capability_pattern",
    "//ui/base",
    "//ui/gfx",
    "//url",
  ]
}

source_set("capability_pattern") {
  sources = [
    "capability_pattern.cc",
    "capability_pattern.h",
  ]
  deps = [
    "//base",
    "//url",
  ]
}

test("capability_pattern_unittests") {
  testonly = true
  sources = [ "capability_pattern_unittest.cc" ]
  deps = [
    "//base",
    "//testing/gtest",
    "//testing/gtest:gtest_main",
    "//tuffite/framework/common:capability_pattern",
    "//url",
  ]
}

test("app_manifest_unittests") {
  testonly = true
  sources = [ "app_manifest_unittest.cc" ]
  deps = [
    ":common",
    "//base",
    "//testing/gtest",
    "//testing/gtest:gtest_main",
    "//url",
  ]
}

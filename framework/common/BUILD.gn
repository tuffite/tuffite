import("//tuffite/tuffite_in_chromium.gni")
assert(tuffite_in_chromium)
import("//testing/test.gni")
source_set("switches") {
  public = [ "switches.h" ]
  sources = public
}
source_set("languages") {
  public = [ "languages.h" ]
  sources = public
}
source_set("access") {
  public = [ "access.h" ]
  sources = public + [ "access.cc" ]
  public_deps = [
    "//base",
    "//url",
  ]
}
test("access_unittests") {
  testonly = true
  sources = [ "access_unittest.cc" ]
  deps = [
    ":access",
    "//base",
    "//testing/gtest",
    "//testing/gtest:gtest_main",
    "//url",
  ]
}

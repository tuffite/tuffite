import("//tuffite/tuffite_in_chromium.gni")
assert(tuffite_in_chromium)
import("//testing/test.gni")

source_set("manifest") {
  public = [
    "effective_manifest.h",
    "manifest_loader.h",
    "manifest_service.h",
    "manifest_service_factory.h",
  ]
  sources = public + [
              "effective_manifest.cc",
              "manifest_loader.cc",
              "manifest_service_factory.cc",
              "manifest_service_impl.cc",
              "manifest_service_impl.h",
            ]
  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//tuffite/components/explorer/common:policy",
    "//tuffite/components/isolated/common:configuration",
    "//tuffite/components/manifest/common:configuration",
    "//tuffite/framework/app/services:factory",
    "//url",
  ]
  deps = [
    "//net",
    "//tuffite/components/explorer/common:external_protocol",
    "//tuffite/components/manifest/common:access",
  ]
}

test("manifest_service_unittests") {
  testonly = true

  sources = [ "manifest_service_unittest.cc" ]
  deps = [
    ":manifest",
    "//base",
    "//testing/gtest",
    "//testing/gtest:gtest_main",
    "//tuffite/components/explorer/common:external_protocol",
    "//tuffite/framework/browser/services/isolated:registry",
    "//url",
  ]
}

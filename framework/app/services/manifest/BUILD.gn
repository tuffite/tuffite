import("//tuffite/tuffite_in_chromium.gni")
assert(tuffite_in_chromium)
import("//testing/test.gni")



source_set("manifest") {
  public = [
    "app_config.h",
    "manifest_service.h",
    "manifest_service_factory.h",
  ]
  sources = public + [
              "manifest_service_factory.cc",
              "manifest_service_impl.cc",
              "manifest_service_impl.h",
            ]
  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//tuffite/framework/app/services:factory",
    "//tuffite/framework/app/services/asset:configuration",
    "//url",
  ]
  deps = [
    "//net",
    "//tuffite/framework/common:access",
  ]
}

test("manifest_service_unittests") {
  testonly = true
  sources = [ "manifest_service_unittest.cc" ]
  deps = [
    ":manifest",
    "//base",
    "//testing/gtest",
    "//testing/gtest:gtest_main",
    "//url",
  ]
}

import("//tuffite/tuffite_in_chromium.gni")
assert(tuffite_in_chromium)

# Copyable resource snapshots are shared by manifest parsing and profile URL
# loading.
source_set("configuration") {
  public = [ "asset_configuration.h" ]
  sources = public + [ "asset_configuration.cc" ]
  public_deps = [
    "//base",
    "//url",
  ]
  deps = [ "//tuffite/framework/common:access" ]
}

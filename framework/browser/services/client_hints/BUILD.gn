  sources = public + [ "client_hints_service_factory.cc" ]
  public_deps = [
    "//base",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//content/public/browser",
  ]
  deps = [
    "//components/client_hints/browser:in_memory",

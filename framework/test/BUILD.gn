import("//tuffite/tuffite_in_chromium.gni")

assert(tuffite_in_chromium)

import("//testing/test.gni")

# Compile the service with a fake injected launcher, excluding the production
# factory and Chromium process launcher. The API headers belong to this test's
# selected source set as well as to the production service target.
test("utility_service_unittests") {
  sources = [
    "//tuffite/framework/app/services/utility/utility_process_launcher.h",
    "//tuffite/framework/app/services/utility/utility_service.h",
    "//tuffite/framework/app/services/utility/utility_service_impl.cc",
    "//tuffite/framework/app/services/utility/utility_types.h",
    "utility_service_unittest.cc",
    "utility_test_main.cc",
  ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//components/keyed_service/core",
    "//mojo/core/embedder",
    "//mojo/public/cpp/bindings",
    "//testing/gtest",
    "//tuffite/framework/common/utility:mojom",
    "//tuffite/framework/common/utility:service_name",
    "//tuffite/framework/public:abi",
  ]
}


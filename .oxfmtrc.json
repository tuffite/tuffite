{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/generated/**",
    "**/target/**",
    "**/dist/**",
    ".cache/**",
    "patches/**",
    "bun.lock"
  ],
  "sortPackageJson": false
}

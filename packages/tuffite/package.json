{
  "name": "tuffite",
  "version": "0.1.0",
  "description": "JavaScript runtime and tooling surface for Tuffite applications",
  "type": "module",
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.js",
      "default": "./generated/index.js"
    },
    "./explorer": {
      "types": "./explorer.d.ts",
      "import": "./explorer.js",
      "default": "./explorer.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js",
      "default": "./vite.js"
    }
  },
  "files": [
    "explorer.js",
    "explorer.d.ts",
    "vite.js",
    "vite.d.ts",
    "generated/*.js",
    "generated/*.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT OR Apache-2.0"
}
